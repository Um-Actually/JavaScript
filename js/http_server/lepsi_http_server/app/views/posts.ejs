<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css">
    <title><%= titulek %></title>
</head>

<body>
    <header>
    <nav class="menu">
        <img src="img/logo.png" alt="Logo kavárny" class="logo">
        <a href="/index">Úvod</a>
        <a href="/menu">Menu</a>
        <a href="/kontakt">Kontakt</a>
        <a href="/posts"class="active">Prispevky</a>
    </nav>
    </header>

    <main>
    <h1><%= titulek %></h1>
    <% if(typeof prispevky == 'undefined' || prispevky.length == 0) { %>
        <p><i>Dosud neexistují žádné příspěvky.</i></p>
    <% } else { %>
    <% for(let i = 0; i < prispevky.length; i++) { %>
        <div id="<%= prispevky[i].id %>">
            <<p><%= prispevky[i].nadpis %> <a href="posts/<%= prispevky[i].id %>">detail</a></p>
        </div>
    <% }} %>
    </main>
    <footer>
    <p>© 2026 Kavárna U Šálku</p>
    <p>
        <a href="#">Instagram</a> |
        <a href="#">Facebook</a>
    </p>
</footer>
</body>

</html>