<%- include('_partials/header') %>
    <h1><%= titulek %></h1>

    <% if(prihlasenyUzivatel!=null) { %>
        <form action="/posts/new" method="post">
        <input type="text" name="nadpis" placeholder="Nadpis..." required /><br />
        <textarea name="obsah" placeholder="Obsah..." required></textarea><br />
        <input type="submit" value="Přidat recenzi" />
    </form>
        
    <%}

     else { %>
        <p><i>Pro přidání recenze se musíte přihlásit.</i></p>
    <%}%>


    <% if(typeof prispevky == 'undefined' || prispevky.length == 0) { %>
        <p><i>Dosud neexistují žádné recenze.</i></p>
    <% } else { %>
    <%  for(let i = prispevky.length - 1; i >= 0; i--) { %>
        <div id="<%= prispevky[i].id %>">
            <p><%= prispevky[i].nadpis %> <a href="/posts/<%= prispevky[i].id %>">detail</a> <% if(prihlasenyUzivatel === prispevky[i].user) { %><a href="/posts/delete/<%= prispevky[i].id %>">smazat</a><% } %></p>
        </div>
    <% }} %>
<%- include('_partials/footer') %>

