<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css">
    <title><%= titulek %></title>
</head>

<body>
    <header>
    <nav class="menu">
        <img src="img/logo.png" alt="Logo kavárny" class="logo">
        <a href="/index">Úvod</a>
        <a href="/menu">Menu</a>
        <a href="/kontakt">Kontakt</a>
        <a href="/posts"class="active">Prispevky</a>
    </nav>
    </header>

    <main>
    <h1><%= titulek %></h1>
    <% if(typeof prispevek == 'undefined' || prispevek == false) { %>
        <p><i>Takový příspěvek neexistuje.</i></p>
    <% } else { %>
        <div id="<%= prispevek.id %>">
            <h2><%= prispevek.nadpis %></h2>
            <p><%= prispevek.obsah %></p>
        </div>
    <% } %>
    <a href="/posts">Zpět</a>
    </main>
    <footer>
    <p>© 2026 Kavárna U Šálku</p>
    <p>
        <a href="#">Instagram</a> |
        <a href="#">Facebook</a>
    </p>
</footer>
</body>

</html>