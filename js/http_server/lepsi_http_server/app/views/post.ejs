<%- include('_partials/header') %>
    <h1><%= titulek %></h1>
    <% if(typeof prispevek == 'undefined' || prispevek == false) { %>
        <p><i>Takový příspěvek neexistuje.</i></p>
    <% } else { %>
        <div id="<%= prispevek.id %>">
            <h2><%= prispevek.nadpis %></h2>
            <p><%= prispevek.obsah %></p>
        </div>
    <% } %>
    <a href="/posts">Zpět</a>
<%- include('_partials/footer') %>

